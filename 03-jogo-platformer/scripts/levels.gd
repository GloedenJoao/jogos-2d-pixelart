static func count() -> int:
	return ERAS.size()

static func era(index: int) -> Dictionary:
	return ERAS[clampi(index, 0, ERAS.size() - 1)]

static func level_data(index: int) -> LevelData:
	return LevelData.parse(era(index).map)
